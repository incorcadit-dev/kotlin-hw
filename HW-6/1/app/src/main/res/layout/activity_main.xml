<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ConstraintLayout 실습"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <ImageView
        android:id="@+id/ivDice1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/dice1"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvPlus"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/tvPlus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="@id/ivDice1"
        app:layout_constraintBottom_toBottomOf="@id/ivDice1"
        app:layout_constraintStart_toEndOf="@id/ivDice1"
        app:layout_constraintEnd_toStartOf="@+id/ivDice2" />

    <ImageView
        android:id="@+id/ivDice2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/dice1"
        app:layout_constraintTop_toTopOf="@id/ivDice1"
        app:layout_constraintStart_toEndOf="@id/tvPlus"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSumLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="합계는?"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/ivDice1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/etSum"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginTop="40dp" />

    <EditText
        android:id="@+id/etSum"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:textSize="18sp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="@id/tvSumLabel"
        app:layout_constraintBottom_toBottomOf="@id/tvSumLabel"
        app:layout_constraintStart_toEndOf="@id/tvSumLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="결과보기"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvSumLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
