<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF0F3"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FrameLayout 실습"
        android:textSize="22sp"
        android:textStyle="bold|italic"
        android:textColor="#7CB342"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Левая колонка: персонаж и аксессуары -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <ImageView
                    android:id="@+id/ivBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/body" />

                <ImageView
                    android:id="@+id/ivobjCrown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:visibility="invisible"
                    android:src="@drawable/crown1" />

                <ImageView
                    android:id="@+id/ivobjNecklace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="88dp"
                    android:visibility="invisible"
                    android:src="@drawable/necklace1" />

                <ImageView
                    android:id="@+id/ivobjDress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:visibility="invisible"
                    android:src="@drawable/dress1" />

            </FrameLayout>

            <!-- Аксессуары: короны и ожерелья (2 ряда) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <ImageView
                    android:id="@+id/imageViewCrown1"
                    android:layout_width="45dp"
                    android:layout_height="40dp"
                    android:src="@drawable/crown1"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/imageViewCrown2"
                    android:layout_width="45dp"
                    android:layout_height="40dp"
                    android:src="@drawable/crown2"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/imageViewNecklace1"
                    android:layout_width="45dp"
                    android:layout_height="40dp"
                    android:src="@drawable/necklace1"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp" />

                <ImageView
                    android:id="@+id/imageViewNecklace2"
                    android:layout_width="45dp"
                    android:layout_height="40dp"
                    android:src="@drawable/necklace2"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Правая колонка: 3 платья вертикально -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imageViewDress1"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitCenter"
                android:src="@drawable/dress1"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="4dp" />

            <ImageView
                android:id="@+id/imageViewDress2"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitCenter"
                android:src="@drawable/dress2"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="4dp" />

            <ImageView
                android:id="@+id/imageViewDress3"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="fitCenter"
                android:src="@drawable/dress3"
                android:clickable="true"
                android:focusable="true"
                android:layout_margin="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Кнопка сброса внизу -->
    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="다시하기"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#00BCD4"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
